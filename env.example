# Copy this file to .env and fill in your own credentials.
# .env is gitignored: never commit real tokens.

# MLflow tracking on DagsHub (training + API model pull)
# Username is your DagsHub account name, password is a DagsHub access token.
MLFLOW_TRACKING_URI=https://dagshub.com/hkayne1987/may26_cmlops_accidents.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# DVC remote on DagsHub (data versioning)
# Same DagsHub account and token as above, under the names the DVC
# container expects.
DAGSHUB_USER=
DAGSHUB_TOKEN=

# API authentication
# Signing key for the JWT access tokens. Must be at least 32 characters:
# the API refuses to start otherwise, since a weak key lets anyone forge
# tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# How long an access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Airflow -> API service account
# The pipeline calls /admin/reload-model with this account once a new model
# clears the release gate. Create it with:
#   make users ARGS="create airflow_service --role service"
API_URL=http://api:8000
API_USERNAME=airflow_service
API_PASSWORD=

# Automatic model reload: how often the API checks the registry for a newly
# promoted @production model, in seconds. 0 disables it.
MODEL_POLL_SECONDS=300

# Airflow pulls the latest images published by CI before each task. Set to
# false to run images you built locally and have not published yet.
PULL_IMAGES=true

# Drift detection (src/monitoring/detection.py). All optional, defaults shown.
# Days of logged predictions compared with the training data.
DRIFT_WINDOW_DAYS=7
# Below this many predictions the check does not conclude.
DRIFT_MIN_ROWS=200
# Training rows sampled as the reference.
DRIFT_REFERENCE_ROWS=20000
# Share of drifted columns that raises the alert.
DRIFT_ALERT_SHARE=0.25

# Grafana configuration
GRAFANA_PASSWORD=admin

# MinIO configuration
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
